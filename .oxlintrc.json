{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "jsx-a11y", "vitest", "import"],
  "jsPlugins": ["eslint-plugin-better-tailwindcss"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [".claude/"],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "apps/playground/app/styles.css",
      "callees": ["cx"]
    }
  },
  "rules": {
    "no-ternary": "error",
    "better-tailwindcss/enforce-canonical-classes": "error",
    "better-tailwindcss/enforce-consistent-class-order": [
      "error",
      {
        "order": "strict"
      }
    ],
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "better-tailwindcss/no-unknown-classes": "error",
    "better-tailwindcss/no-unnecessary-whitespace": "error",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/no-restricted-classes": [
      "error",
      {
        "restrict": [
          {
            "pattern": "^(?:[^:\\[]*(?:\\[[^\\]]*\\])?[^:\\[]*:)*[^:\\[]*\\[[^\\]]*\\][^:]*$",
            "message": "No arbitrary values: use a Tailwind theme utility. A value with no Figma variable is a question for the designer."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/ui/src/**/*.tsx"],
      "rules": {
        "better-tailwindcss/enforce-consistent-line-wrapping": [
          "error",
          {
            "printWidth": 110,
            "group": "newLine",
            "strictness": "loose"
          }
        ]
      }
    },
    {
      "files": ["packages/ui/src/class-names.test.ts"],
      "rules": {
        "better-tailwindcss/no-unknown-classes": "off"
      }
    },
    {
      "files": ["packages/ui/src/theme.test.ts"],
      "rules": {
        "vitest/no-conditional-expect": "off"
      }
    }
  ]
}
